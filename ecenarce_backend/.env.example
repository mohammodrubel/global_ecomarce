NODE_ENV=development
PORT=9000

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

BCRYPT_SALT_ROUNDS=10

JWT_ACCESS_TOKEN_SECRET="your_access_token_secret"
JWT_REFRESH_TOKEN_SECRET="your_refresh_token_secret"

JWT_ACCESS_TOKEN_EXPIRES_IN="7d"
JWT_REFRESH_TOKEN_EXPIRES_IN="90d"

STRIPE_SECRET_KEY="sk_test_xxx"
PUBLISH_KEY="pk_test_xxx"

# EPS Sandbox Payment Gateway
EPS_BASE_URL="https://sandboxpgapi.eps.com.bd"
EPS_USERNAME="your_username"
EPS_PASSWORD="your_password"
EPS_MERCHANT_ID="your_merchant_id"
EPS_STORE_ID="your_store_id"
# x-hash = base64(HMAC-SHA512(EPS_HASH_KEY, userName | merchantTransactionId))
EPS_HASH_KEY="your_hash_key"

FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:9000"
